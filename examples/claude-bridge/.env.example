# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# OpenWA gateway
OPENWA_URL=http://localhost:2785
OPENWA_API_KEY=owa_xxxxxxxx

# Same secret you register on the OpenWA webhook (min 16 chars)
OPENWA_WEBHOOK_SECRET=change-me-to-a-long-random-secret

# Port the bridge listens on
PORT=3001

# Time zone for the night pause (IANA name). Node also takes TZ as the process time zone;
# the bridge's logs stay in UTC either way.
TZ=America/Argentina/Buenos_Aires
# Night pause, in whole hours (0-23) of TZ: from NIGHT_PAUSE_START until NIGHT_PAUSE_END.
# It applies to proactive messages only; replies to a customer who wrote first are still sent.
# The bridge sends no proactive messages today, so these hours change nothing yet.
NIGHT_PAUSE_START=22
NIGHT_PAUSE_END=8
